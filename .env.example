# Copy to .env.local and fill in. .env.local is gitignored, so keep a copy of it
# in your Google Drive "StudyBuddy secrets" folder.

# Firebase config (public client identifiers, safe in the browser bundle).
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key (Google AI Studio). Server-side only (api/*.js). Also add it in Vercel project settings.
GEMINI_API_KEY=
